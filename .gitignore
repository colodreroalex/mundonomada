# Dependencies and generated frontend files
node_modules/
dist/
.angular/
coverage/

# Local/editor configuration
.env
.env.*
!.env.example
.vscode/
.idea/

# Database exports can contain customer accounts, password hashes and tokens.
*.sql
!database/schema.sql
